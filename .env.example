# Copy to .env ONLY for local development (do not commit secrets).
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/tesoria_dev?sslmode=require
JWT_SECRET=replace-with-long-random-secret-for-local-development
# Optional in development; required for production email delivery:
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Tesoria
# Required in production. Public information; do not place secrets here.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_COUNTRY=
LEGAL_OPERATOR_ADDRESS=
PRIVACY_CONTACT_EMAIL=anguelmiguel31@gmail.com
# Describe actual provider entities/regions, international transfers, processing
# grounds where applicable, and retention/deletion periods for logs and backups.
# Include a postal address if applicable law requires it. This text is public.
PRIVACY_OPERATIONS_NOTE=
# If DATABASE_URL_POOLED is set, it OVERRIDES DATABASE_URL.
# DATABASE_URL_POOLED=
# Production is indexable by search engines by default. Set to 1 on staging so
# robots.txt blocks crawlers and the sitemap is not served.
# DISALLOW_INDEXING=1
