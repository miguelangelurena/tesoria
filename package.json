{
  "name": "tesoria",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm ci --include=dev --prefix client && npm run build --prefix client",
