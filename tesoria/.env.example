# Database (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Secret used to sign sessions and codes. At least 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-string

# Email via Brevo HTTPS API. Without these, codes are printed in the terminal (dev mode).
BREVO_API_KEY=xkeysib-your-api-key
MAIL_FROM_EMAIL=verified-sender@yourdomain.com
MAIL_FROM_NAME=Tesoria
